# ========================================================
# MiniChat Environment Variables Configuration Template
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/minichat
# For Kubernetes: Use Service DNS name or secret-injected env vars
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/minichat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=minichat

# Redis (Pub/Sub & Ephemeral Presence)
# Format: redis://[host]:[port]
# For Docker Compose: redis://redis:6379
# For Kubernetes: redis://redis-service.default.svc.cluster.local:6379
REDIS_URL=redis://redis:6379

# Authentication & Security
# Generate a strong 32+ character string in production
JWT_SECRET=minichat-super-secure-devops-portfolio-secret-key-32chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Frontend Configuration (Vite client-side env vars)
VITE_API_URL=
VITE_WS_URL=

# AI Studio Platform Injected Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
